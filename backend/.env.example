# ─── Konfigurasi Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL dasar API (dipakai untuk membentuk link verifikasi email).
APP_URL=http://localhost:4000

# ─── Konfigurasi Database MySQL ──────────────────────────────────────
# Sesuaikan dengan host, port, user, password & nama database MySQL kamu.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=videobelajar

# Batas koneksi pool
DB_CONNECTION_LIMIT=10

# Asal (origin) frontend yang diizinkan mengakses API (CORS).
# Pisahkan dengan koma bila lebih dari satu. Kosongkan / * untuk mengizinkan semua.
CORS_ORIGIN=http://localhost:5173

# ─── Autentikasi (JWT) ───────────────────────────────────────────────
# Kunci rahasia untuk menandatangani & memverifikasi token. WAJIB diganti
# dengan string acak yang panjang di produksi.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1d

# ─── Pengiriman Email (nodemailer) ───────────────────────────────────
# Biarkan MAIL_HOST kosong untuk memakai akun uji Ethereal otomatis
# (email tidak benar-benar terkirim; muncul preview URL di console).
# Untuk SMTP nyata (mis. Gmail), isi host/port/user/pass di bawah.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Video Belajar <no-reply@videobelajar.test>"

# ─── Upload ──────────────────────────────────────────────────────────
# Folder penyimpanan file upload (relatif terhadap root backend).
UPLOAD_DIR=uploads
# Batas ukuran file upload dalam byte (default 2MB).
UPLOAD_MAX_SIZE=2097152
