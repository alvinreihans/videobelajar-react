# =====================================================================
#  .gitignore — Monorepo Video Belajar (berlaku utk frontend/ & backend/)
# =====================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output (pola tanpa slash → cocok di subfolder mana pun)
node_modules
dist
dist-ssr
build
coverage
*.local

# Env (jangan commit .env asli; .env.example tetap di-track)
.env
.env.*
!.env.example

# Upload backend (file unggahan tidak masuk repo, kecuali penanda folder)
backend/uploads/*
!backend/uploads/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Aset desain / mockup (jangan masuk repo)
video-belajar-figma/
